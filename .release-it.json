{
  "non-interactive": false,
  "increment": "patch",
  "preReleaseId": null,
  "hooks": {
    "after:bump": ["ncu -u --packageFile package.json sd-utils", "npm update sd-utils", "npm run build", "npm test"]
  },
  "changelogCommand": "git log --pretty=format:\"* %s (%h)\" [REV_RANGE]",
  "npm": {
    "publish": true
  },
  "git": {
    "requireCleanWorkingDir": false
  }
}
