{
  "name": "sd-model",
  "version": "0.2.11",
  "description": "SilverDecisions data model module",
  "main": "index.js",
  "scripts": {
    "clean": "node scripts/clean.js",
    "build": "npm run clean && rollup -c",
    "test": "node --test \"test/contract/*.test.js\" && jasmine --config=test/jasmine.json",
    "test:build": "node scripts/check-build.js",
    "release": "release-it --verbose"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SilverDecisions/sd-model.git"
  },
  "keywords": [
    "SilverDecisions"
  ],
  "author": "Michał Wasiluk",
  "license": "LGPL-3.0",
  "bugs": {
    "url": "https://github.com/SilverDecisions/sd-model/issues"
  },
  "homepage": "https://github.com/SilverDecisions/sd-model#readme",
  "browserify": {
    "transform": [
      [
        "babelify",
        {
          "presets": [
            "@babel/preset-env"
          ],
          "plugins": [
            "transform-class-properties",
            "transform-object-assign",
            [
              "transform-builtin-extend",
              {
                "globals": [
                  "Error"
                ]
              }
            ]
          ]
        }
      ]
    ]
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/register": "^7.29.7",
    "@rollup/plugin-babel": "^7.1.0",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.2",
    "acorn": "^8.19.0",
    "babel-plugin-transform-builtin-extend": "^1.1.2",
    "babel-plugin-transform-class-properties": "^6.24.1",
    "babel-plugin-transform-object-assign": "^6.22.0",
    "babelify": "^10.0.0",
    "browserify": "^17.0.1",
    "jasmine": "^6.3.0",
    "release-it": "^14.11.6",
    "rollup": "^4.67.3"
  },
  "dependencies": {
    "sd-utils": "^0.1.15"
  }
}
